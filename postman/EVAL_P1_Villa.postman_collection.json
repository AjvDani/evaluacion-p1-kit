        {
          "name": "Listar reservas - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const bookings = pm.response.json();",
                  "pm.test(\"200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(bookings).to.be.an(\"array\");",
                  "  pm.expect(bookings.length).to.be.above(0);",
                  "});",
                  "pm.test(\"Cada reserva incluye user y schedule\", function () {",
                  "  bookings.forEach(function (booking) {",
                  "    pm.expect(booking).to.have.property(\"user\");",
                  "    pm.expect(booking).to.have.property(\"schedule\");",
                  "  });",
                  "});",
                  "const scheduleIds = [...new Set(bookings.map(function (booking) { return booking.scheduleId; }))];",
                  "pm.environment.set(\"scheduleId\", scheduleIds[0] || \"\");",
                  "pm.environment.set(\"otherScheduleId\", scheduleIds[1] || scheduleIds[0] || \"\");",
                  "const adminId = Number(pm.environment.get(\"adminId\"));",
                  "const userId = Number(pm.environment.get(\"userId\"));",
                  "const adminBooking = bookings.find(function (booking) { return booking.userId === adminId; });",
                  "const userBooking = bookings.find(function (booking) { return booking.userId === userId; });",
                  "pm.environment.set(\"adminBookingId\", adminBooking ? adminBooking.id : 999999);",
                  "pm.environment.set(\"userBookingId\", userBooking ? userBooking.id : 999999);"
                ]
              }
            }
          ],
