                  "const base = Date.now() + 5 * 365 * 24 * 60 * 60 * 1000;",
                  "pm.environment.set(\"bookingDate\", new Date(base).toISOString());",
                  "pm.environment.set(\"bookingDate2\", new Date(base + 86400000).toISOString());",
                  "pm.environment.set(\"bookingDate3\", new Date(base + 172800000).toISOString());"
